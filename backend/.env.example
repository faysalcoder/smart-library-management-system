APP_NAME="SLMS API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---- Database (PostgreSQL via Supabase) ------------------------------------
# Get these from your Supabase project: Project Settings > Database >
# Connection string > "Session pooler" (works well with Laravel's persistent
# PDO connections). Example host: aws-0-ap-southeast-1.pooler.supabase.com
DB_CONNECTION=pgsql
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.xxxxxxxxxxxxxxxxxxxx
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

# ---- Sanctum / SPA -------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
SESSION_DOMAIN=localhost

# Comma-separated origins allowed to call this API (the React dev server)
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Library policy defaults (overridable at runtime in system_settings) --
LIBRARY_LOAN_PERIOD_DAYS=14
LIBRARY_MAX_BOOKS_PER_STUDENT=3
LIBRARY_FINE_RATE_PER_DAY=5.00
LIBRARY_FINE_GRACE_DAYS=0
LIBRARY_FINE_MAX_CAP=500.00
LIBRARY_FINE_BLOCK_THRESHOLD=100.00
LIBRARY_MAX_RENEWALS=1
