{
  "name": "smart-library-management-system",
  "private": true,
  "version": "1.0.0",
  "description": "SLMS monorepo root — orchestrates local dev and deployment for backend/ (Laravel) and frontend/ (React).",
  "scripts": {
    "dev": "concurrently -k -n BACKEND,FRONTEND -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "node scripts/run-backend.js",
    "dev:frontend": "cd frontend && npm run dev",
    "deploy": "node scripts/deploy.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
