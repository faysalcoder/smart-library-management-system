            "url": { "raw": "{{base_url}}/admin/settings", "host": ["{{base_url}}"], "path": ["admin", "settings"] }
          }
        },
        {
          "name": "Update settings",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"settings\": {\n    \"loan_period_days\": 14,\n    \"fine_rate_per_day\": 5.00,\n    \"max_books_per_student\": 3\n  }\n}"
            },
            "url": { "raw": "{{base_url}}/admin/settings", "host": ["{{base_url}}"], "path": ["admin", "settings"] },
            "description": "Fine changes apply to NEW fines only — existing fines keep their snapshot rate (ADR-08)."
          }
        },
        {
          "name": "Audit log",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/admin/logs?page=1&per_page=50",
              "host": ["{{base_url}}"],
              "path": ["admin", "logs"],
              "query": [
                { "key": "action", "value": "", "disabled": true },
                { "key": "q", "value": "", "disabled": true },
                { "key": "from", "value": "", "disabled": true },
                { "key": "to", "value": "", "disabled": true },
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "50" }
              ]
            },
            "description": "Append-only. There is deliberately no write endpoint for this resource."
          }
        }
      ]
    },
    {
      "name": "Backup & Recovery (§1.4, §2.10)",
      "item": [
        {
          "name": "List backups",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/admin/backups", "host": ["{{base_url}}"], "path": ["admin", "backups"] }
          }
        },
        {
          "name": "Create backup",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/admin/backups", "host": ["{{base_url}}"], "path": ["admin", "backups"] },
            "description": "Produces a full logical SQL dump in pure PHP — no dependency on `mysqldump` being present on PATH."
          }
        },
        {
          "name": "Download backup",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/admin/backups/slms-backup-20260731-020000.sql/download",
              "host": ["{{base_url}}"],
              "path": ["admin", "backups", "slms-backup-20260731-020000.sql", "download"]
            },
            "description": "Replace the filename with one returned by **List backups**."
          }
        },
        {
          "name": "Restore backup (DESTRUCTIVE)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"confirm\": \"RESTORE\"\n}" },
            "url": {
              "raw": "{{base_url}}/admin/backups/slms-backup-20260731-020000.sql/restore",
              "host": ["{{base_url}}"],
              "path": ["admin", "backups", "slms-backup-20260731-020000.sql", "restore"]
            },
            "description": "⚠️ Drops and rebuilds every table. Requires the literal confirmation string `RESTORE`, and everyone is signed out afterwards."
          }
        },
        {
          "name": "Delete backup",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/admin/backups/slms-backup-20260731-020000.sql",
              "host": ["{{base_url}}"],
              "path": ["admin", "backups", "slms-backup-20260731-020000.sql"]
            }
          }
        }
      ]
    },
