    {
      "name": "Administration (FR-09)",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/admin/users", "host": ["{{base_url}}"], "path": ["admin", "users"] },
            "description": "Sign in as `admin` first."
          }
        },
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"librarian2\",\n  \"email\": \"librarian2@wub.edu.bd\",\n  \"full_name\": \"Second Librarian\",\n  \"password\": \"Password123\",\n  \"password_confirmation\": \"Password123\",\n  \"role_id\": 2\n}"
            },
            "url": { "raw": "{{base_url}}/admin/users", "host": ["{{base_url}}"], "path": ["admin", "users"] }
          }
        },
        {
          "name": "Set user status (BR-13)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"inactive\"\n}" },
            "url": { "raw": "{{base_url}}/admin/users/2/status", "host": ["{{base_url}}"], "path": ["admin", "users", "2", "status"] },
            "description": "BR-13: disabling the last active administrator is refused with 409."
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/admin/users/2/reset-password", "host": ["{{base_url}}"], "path": ["admin", "users", "2", "reset-password"] },
            "description": "Returns a one-time temporary password and signs the user out everywhere."
          }
        },
